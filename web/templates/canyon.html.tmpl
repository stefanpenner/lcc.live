<!DOCTYPE html>
<html lang="en">
  <head>
    {{template "head_common" .}}
    
    <style>
      /* content-visibility: auto removed - causes iOS Safari flicker on scroll */
      
      /* View Transitions for smooth page changes */
      @view-transition {
        navigation: auto;
      }
      
      /* Smooth fade for root */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 0.3s;
      }
      
      /* Crossfade animation */
      ::view-transition-old(root) {
        animation-name: fade-out;
      }
      
      ::view-transition-new(root) {
        animation-name: fade-in;
      }
      
      @keyframes fade-out {
        to {
          opacity: 0;
        }
      }
      
      @keyframes fade-in {
        from {
          opacity: 0;
        }
      }
      
      /* Smooth transitions for images specifically */
      camera-feed {
        view-transition-name: auto;
      }
      
      /* Smooth transition for sticky chrome */
      .top-bar {
        view-transition-name: top-bar;
      }
      
      ::view-transition-old(top-bar),
      ::view-transition-new(top-bar) {
        animation-duration: 0.2s;
      }
    </style>
    
    <!-- Page Title -->
    <title>{{.Name}} Live Cameras | Utah Canyon Conditions</title>
    
    <!-- SEO & Social -->
    <meta name="description" content="Live camera feeds for {{if eq .Name "LCC"}}Little Cottonwood Canyon{{else}}Big Cottonwood Canyon{{end}}. Real-time road conditions and weather updates.">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://lcc.live{{if eq .Name "BCC"}}/bcc{{end}}">
    <meta property="og:title" content="{{.Name}} Live Cameras | Utah Canyon Conditions">
    <meta property="og:description" content="Live camera feeds for {{if eq .Name "LCC"}}Little Cottonwood Canyon{{else}}Big Cottonwood Canyon{{end}}. Real-time road conditions and weather updates.">
    <meta property="og:site_name" content="LCC.live">
    {{- if .Cameras -}}
    {{- range $index, $c := .Cameras -}}
    {{- if eq $index 0 -}}
    {{- if ne $c.Kind "iframe" -}}
    <meta property="og:image" content="https://lcc.live/image/{{$c.ID}}">
    <meta property="og:image:alt" content="{{$c.Alt}}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {{- end -}}
    {{- end -}}
    {{- end -}}
    {{- end -}}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://lcc.live{{if eq .Name "BCC"}}/bcc{{end}}">
    <meta name="twitter:title" content="{{.Name}} Live Cameras | Utah Canyon Conditions">
    <meta name="twitter:description" content="Live camera feeds for {{if eq .Name "LCC"}}Little Cottonwood Canyon{{else}}Big Cottonwood Canyon{{end}}.">
    {{- if .Cameras -}}
    {{- range $index, $c := .Cameras -}}
    {{- if eq $index 0 -}}
    {{- if ne $c.Kind "iframe" -}}
    <meta name="twitter:image" content="https://lcc.live/image/{{$c.ID}}">
    {{- end -}}
    {{- end -}}
    {{- end -}}
    {{- end -}}
    
    <!-- Mobile Optimization (page-specific) -->
    <meta name="apple-mobile-web-app-title" content="{{.Name}} Live">
    
    <!-- Prefetch -->
    {{- if eq .Name "LCC" -}}
    <link rel="prefetch" href="/bcc" as="document">
    {{- else -}}
    <link rel="prefetch" href="/" as="document">
    {{- end -}}
  </head>
  
  <body>
    <!-- Sticky chrome: canyon toggle + road chips -->
    <header class="top-bar" role="banner">
      <nav class="canyon-nav" role="navigation" aria-label="Canyon selection">
        <div class="canyon-toggle">
        {{ if eq .Name "LCC" -}}
        <a href="/" 
           aria-current="page" 
           class="active" 
           role="button"
           aria-label="Little Cottonwood Canyon, currently selected">
          LCC
        </a>
        <a href="/bcc" 
           role="button"
           aria-label="Switch to Big Cottonwood Canyon">
          BCC
        </a>
        {{- else -}}
        <a href="/" 
           role="button"
           aria-label="Switch to Little Cottonwood Canyon">
          LCC
        </a>
        <a href="/bcc" 
           aria-current="page" 
           class="active" 
           role="button"
           aria-label="Big Cottonwood Canyon, currently selected">
          BCC
        </a>
        {{- end -}}
        </div>
      </nav>

      <div class="top-bar-chips" role="group" aria-label="Status chips">
        {{- /* UAC Salt Lake (both canyons) */ -}}
        {{- if .AvalancheDanger -}}
        <a class="status-chip uac-chip {{uacDangerClass .AvalancheDanger.DangerLevel .AvalancheDanger.Danger}}"
           id="uac-chip"
           href="{{if .AvalancheDanger.Link}}{{.AvalancheDanger.Link}}{{else}}https://utahavalanchecenter.org/forecast/salt-lake{{end}}"
           target="_blank"
           rel="noopener noreferrer"
           data-danger-level="{{.AvalancheDanger.DangerLevel}}"
           aria-label="Utah Avalanche Center Salt Lake: {{uacDangerLabel .AvalancheDanger.Danger}}{{if .AvalancheDanger.TravelAdvice}}. {{.AvalancheDanger.TravelAdvice}}{{end}}">
          UAC: {{uacDangerLabel .AvalancheDanger.Danger}}
        </a>
        {{- else -}}
        <a class="status-chip uac-chip uac-none" id="uac-chip" href="https://utahavalanchecenter.org/forecast/salt-lake" target="_blank" rel="noopener noreferrer" hidden aria-label="Utah Avalanche Center Salt Lake forecast">UAC: —</a>
        {{- end -}}

        {{- /* Alta parking / road — LCC only */ -}}
        {{- if eq .Name "LCC" -}}
        {{- if .AltaStatus -}}
        {{- if .AltaStatus.ParkingStatus -}}
        <span class="status-chip alta-chip{{if altaParkingWarn .AltaStatus.ParkingStatus}} road-chip-warn{{end}}"
              id="alta-parking-chip"
              data-status="{{.AltaStatus.ParkingStatus}}"
              aria-label="Alta parking: {{.AltaStatus.ParkingStatus}}{{if .AltaStatus.ParkingMessage}}. {{.AltaStatus.ParkingMessage}}{{end}}">
          Alta park: {{.AltaStatus.ParkingStatus}}
        </span>
        {{- else -}}
        <span class="status-chip alta-chip" id="alta-parking-chip" hidden></span>
        {{- end -}}
        {{- if .AltaStatus.RoadStatus -}}
        <span class="status-chip alta-chip alta-road-chip{{if altaParkingWarn .AltaStatus.RoadStatus}} road-chip-warn{{end}}"
              id="alta-road-chip"
              data-status="{{.AltaStatus.RoadStatus}}"
              aria-label="Alta road: {{.AltaStatus.RoadStatus}}{{if .AltaStatus.RoadMessage}}. {{.AltaStatus.RoadMessage}}{{end}}">
          Alta road: {{.AltaStatus.RoadStatus}}
        </span>
        {{- else -}}
        <span class="status-chip alta-chip alta-road-chip" id="alta-road-chip" hidden></span>
        {{- end -}}
        {{- else -}}
        <span class="status-chip alta-chip" id="alta-parking-chip" hidden></span>
        <span class="status-chip alta-chip alta-road-chip" id="alta-road-chip" hidden></span>
        {{- end -}}
        {{- end -}}

        {{- /* UDOT events (cap 3 + overflow); client may rebuild */ -}}
        <div class="events-strip" id="events-strip" role="list" aria-label="Traffic events" data-event-count="{{len .Events}}"{{if not .Events}} hidden{{end}}>
          {{- range $i, $ev := .Events -}}
          {{- if lt $i 3 -}}
          <span class="status-chip event-chip{{if eventIsWarn $ev.IsFullClosure $ev.Severity}} road-chip-warn{{end}}"
                role="listitem"
                data-event-id="{{$ev.ID}}"
                title="{{if $ev.Name}}{{$ev.Name}}{{else}}{{$ev.Description}}{{end}}"
                aria-label="{{if $ev.Name}}{{$ev.Name}}{{else}}{{$ev.Description}}{{end}}{{if $ev.IsFullClosure}} (full closure){{end}}">
            {{eventLabel $ev.Name $ev.Description}}
          </span>
          {{- end -}}
          {{- end -}}
          {{- if gt (len .Events) 3 -}}
          <span class="status-chip event-chip event-chip-more" id="events-more" role="listitem" aria-label="{{printf "%d more events" (sub (len .Events) 3)}}">+{{sub (len .Events) 3}}</span>
          {{- end -}}
        </div>
      </div>

      <section class="road-conditions-banner road-conditions-banner--stack" role="region" aria-label="Road conditions"{{if not .RoadConditions}} hidden{{end}}>
        {{- range $i, $cond := .RoadConditions -}}
        <div class="road-conditions-card" data-condition-id="{{$cond.Id}}">
          <h3 class="road-condition-title" title="{{$cond.RoadwayName}}">{{$cond.RoadwayName}}</h3>
          <div class="road-condition-content">
            <span class="road-chip" data-kind="road" data-condition="{{$cond.RoadCondition}}" aria-label="Road: {{$cond.RoadCondition}}">{{$cond.RoadCondition}}</span>
            <span class="road-chip" data-kind="weather" data-condition="{{$cond.WeatherCondition}}" aria-label="Weather: {{$cond.WeatherCondition}}">{{$cond.WeatherCondition}}</span>
            <span class="road-chip{{if hasActiveRestriction $cond.Restriction}} road-chip-warn{{else}} road-chip-muted{{end}}" data-kind="restriction" aria-label="Restriction: {{if $cond.Restriction}}{{$cond.Restriction}}{{else}}none{{end}}">{{if $cond.Restriction}}{{$cond.Restriction}}{{else}}none{{end}}</span>
            <time class="road-chip road-chip-muted road-condition-updated" datetime="{{$cond.LastUpdated}}" data-last-updated="{{$cond.LastUpdated}}" aria-label="Updated {{formatTimeAgo $cond.LastUpdated}} ago">
              <span class="road-condition-time-ago">{{formatTimeAgo $cond.LastUpdated}}</span>
            </time>
          </div>
        </div>
        {{- end -}}
      </section>
    </header>
    
    <!-- Camera Grid -->
    <main role="main">
      <section 
        id="container" 
        role="region" 
        aria-label="{{if eq .Name "LCC"}}Little Cottonwood Canyon{{else}}Big Cottonwood Canyon{{end}} camera feeds">
        {{- range $index, $c := .Cameras -}}
        {{- if ne $c.Kind "roadstatus" -}}
        <camera-feed
          data-camera-id="{{$c.ID}}"
          tabindex="0"
          role="article"
          aria-label="{{$c.Alt}} camera feed">
          
          {{- if eq $c.Kind "iframe" -}}
          <!-- Embedded iframe camera -->
          <iframe 
            loading="lazy" 
            src="{{$c.Src}}" 
            title="{{$c.Alt}}" 
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin"
            aria-label="{{$c.Alt}}">
          </iframe>
          {{- else -}}
          <!-- Standard image camera with link to camera detail page -->
          <a href="/camera/{{if $c.Alt}}{{slugify $c.Alt}}{{else}}{{$c.ID}}{{end}}" aria-label="View {{$c.Alt}} full page">
          {{- if le $index 1 -}}
          <img 
            src="/image/{{$c.ID}}" 
            alt="{{$c.Alt}}"
            loading="eager"
            class="in-viewport">
          {{- else -}}
          <img 
            src="/image/{{$c.ID}}" 
            alt="{{$c.Alt}}" 
            loading="lazy">
          {{- end -}}
          </a>
          {{- end -}}
          
          <div class="camera-footer">
            <h4>{{$c.Alt}}</h4>
            {{- $station := index $.WeatherStations $c.ID -}}
            {{- if and $station (not (isStale $station.LastUpdated)) -}}
            {{- if $station.AirTemperature -}}
            <span class="camera-temp">{{roundTemp $station.AirTemperature}}°F</span>
            {{- end -}}
            {{- if $station.WindSpeedAvg -}}
            <span class="camera-weather-chip">{{roundTemp $station.WindSpeedAvg}} mph{{if $station.WindDirection}} {{$station.WindDirection}}{{end}}</span>
            {{- end -}}
            {{- if $station.SurfaceStatus -}}
            <span class="camera-weather-chip">{{$station.SurfaceStatus}}</span>
            {{- end -}}
            {{- if $station.Precipitation -}}
            <span class="camera-weather-chip">{{precipIcon $station.AirTemperature}}</span>
            {{- end -}}
            {{- end -}}
            <div class="camera-actions">
              <button class="fullscreen-button" 
                      data-camera-id="{{$c.ID}}"
                      aria-label="View {{$c.Alt}} fullscreen"
                      title="View fullscreen">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
                </svg>
              </button>
              <button class="share-button" 
                      data-camera-id="{{$c.ID}}" 
                      data-camera-name="{{$c.Alt}}"
                      data-camera-kind="{{$c.Kind}}"
                      aria-label="Share {{$c.Alt}}"
                      title="Share this camera">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                </svg>
              </button>
            </div>
          </div>
        </camera-feed>
        {{- end -}}
        {{- end -}}
      </section>
    </main>
    
    <!-- Lightbox Overlay -->
    <the-overlay 
      role="dialog" 
      aria-modal="true" 
      aria-label="Enlarged camera view">
    </the-overlay>

    <script type="module" src="/s/script.mjs?v={{version}}"></script>
    {{template "analytics" .}}
  </body>
</html>
