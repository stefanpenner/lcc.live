<!DOCTYPE html>
<html lang="en">
  <head>
    {{template "head_common" .}}
    
    <!-- Page Title -->
    <title>{{.Camera.Alt}} | {{.CanyonName}} Live Camera</title>
    
    <!-- SEO & Social -->
    <meta name="description" content="Live camera view from {{.Camera.Alt}} in {{if eq .CanyonName "LCC"}}Little Cottonwood Canyon{{else}}Big Cottonwood Canyon{{end}}. Real-time road conditions and weather updates.">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="LCC.live">
    <meta property="og:url" content="https://lcc.live/camera/{{if .Camera.Alt}}{{slugify .Camera.Alt}}{{else}}{{.Camera.ID}}{{end}}">
    <meta property="og:title" content="{{.Camera.Alt}} | {{.CanyonName}} Live Camera">
    <meta property="og:description" content="Live camera view from {{.Camera.Alt}} in {{if eq .CanyonName "LCC"}}Little Cottonwood Canyon{{else}}Big Cottonwood Canyon{{end}}. Real-time road conditions and weather updates.">
    <meta property="og:locale" content="en_US">
    {{- if ne .Camera.Kind "iframe" -}}
    <meta property="og:image" content="https://lcc.live{{.ImageURL}}">
    <meta property="og:image:secure_url" content="https://lcc.live{{.ImageURL}}">
    <meta property="og:image:alt" content="{{.Camera.Alt}} - {{.CanyonName}} Live Camera">
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="800">
    {{- end -}}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="{{if eq .Camera.Kind "iframe"}}summary{{else}}summary_large_image{{end}}">
    <meta name="twitter:url" content="https://lcc.live/camera/{{if .Camera.Alt}}{{slugify .Camera.Alt}}{{else}}{{.Camera.ID}}{{end}}">
    <meta name="twitter:title" content="{{.Camera.Alt}} | {{.CanyonName}} Live Camera">
    <meta name="twitter:description" content="Live camera view from {{.Camera.Alt}} in {{if eq .CanyonName "LCC"}}Little Cottonwood Canyon{{else}}Big Cottonwood Canyon{{end}}. Real-time road conditions and weather updates.">
    {{- if ne .Camera.Kind "iframe" -}}
    <meta name="twitter:image" content="https://lcc.live{{.ImageURL}}">
    <meta name="twitter:image:alt" content="{{.Camera.Alt}} - {{.CanyonName}} Live Camera">
    {{- end -}}
    
    <!-- Mobile Optimization (page-specific) -->
    <meta name="apple-mobile-web-app-title" content="{{.CanyonName}} Live">
    
    <!-- Prefetch canyon page -->
    <link rel="prefetch" href="{{.CanyonPath}}" as="document">
    
    <style>
      /* Camera detail — image first, one chrome line */
      body.camera-detail {
        --body-pad: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .camera-chrome {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
        min-height: 2.5rem;
        padding: max(0.35rem, env(safe-area-inset-top, 0px)) 0.6rem 0.35rem;
        background: color-mix(in srgb, var(--color-bg-primary) 90%, transparent);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--color-border-default);
        font-size: 0.8125rem;
      }

      @supports not (background: color-mix(in srgb, white 50%, transparent)) {
        .camera-chrome {
          background: var(--color-bg-primary);
        }
      }

      .camera-chrome .back {
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        color: var(--color-accent-focus);
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
        flex-shrink: 0;
      }

      .camera-chrome .back:hover {
        text-decoration: underline;
      }

      .camera-chrome .back:focus-visible {
        outline: 2px solid var(--color-accent-focus);
        outline-offset: 2px;
        border-radius: 2px;
      }

      .camera-chrome .sep {
        color: var(--color-text-tertiary);
        opacity: 0.5;
        flex-shrink: 0;
      }

      .camera-chrome h1 {
        margin: 0;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
        max-width: min(40vw, 18rem);
      }

      .camera-chrome .facts {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        flex-wrap: wrap;
        margin-left: auto;
      }

      .camera-chrome .fact {
        display: inline-flex;
        align-items: center;
        padding: 0.12rem 0.45rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--color-text-secondary);
        background: var(--color-bg-tertiary);
        white-space: nowrap;
      }

      .camera-chrome .fact.muted {
        color: var(--color-text-tertiary);
        background: transparent;
        font-weight: 400;
        font-variant-numeric: tabular-nums;
      }

      .camera-chrome .fact.stale {
        opacity: 0.7;
        color: #d97706;
      }

      .photo-stage {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        min-height: 0;
        width: 100%;
      }

      .photo-stage img {
        display: block;
        width: 100%;
        height: auto;
        max-height: min(78vh, 900px);
        object-fit: contain;
        background: #000;
      }

      .photo-stage iframe {
        display: block;
        width: 100%;
        max-width: 1400px;
        aspect-ratio: 16 / 9;
        min-height: min(50vh, 400px);
        max-height: min(78vh, 900px);
        border: none;
        background: #000;
      }

      .weather-dense {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
        padding: 0.5rem 0.6rem max(0.75rem, env(safe-area-inset-bottom, 0px));
        border-top: 1px solid var(--color-border-default);
        background: var(--color-bg-secondary);
      }

      .weather-dense .wx-title {
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--color-text-tertiary);
        margin-right: 0.15rem;
      }

      .weather-dense .wx {
        display: inline-flex;
        flex-direction: column;
        padding: 0.28rem 0.5rem;
        background: var(--color-bg-primary);
        border: 1px solid var(--color-border-default);
        border-radius: 4px;
        min-width: 3.75rem;
        line-height: 1.15;
      }

      .weather-dense .wx .l {
        font-size: 0.6rem;
        color: var(--color-text-tertiary);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .weather-dense .wx .v {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-text-primary);
      }

      .weather-dense .wx-updated {
        font-size: 0.7rem;
        color: var(--color-text-tertiary);
        margin-left: auto;
        font-variant-numeric: tabular-nums;
      }

      .weather-dense .wx-updated.stale {
        color: #d97706;
      }

      @media (max-width: 480px) {
        .camera-chrome h1 {
          max-width: 42vw;
          font-size: 0.8rem;
        }

        .photo-stage img {
          max-height: min(70vh, 720px);
        }
      }
    </style>
  </head>
  
  <body class="camera-detail">
    <header class="camera-chrome" role="banner">
      <a href="{{.CanyonPath}}" class="back" aria-label="Back to {{.CanyonName}} cameras">← {{.CanyonName}}</a>
      <span class="sep" aria-hidden="true">·</span>
      <h1>{{.Camera.Alt}}</h1>
      {{- if .WeatherStation -}}
      <div class="facts">
        {{- if .WeatherStation.AirTemperature -}}
        <span class="fact{{if isStale .WeatherStation.LastUpdated}} stale{{end}}">{{roundTemp .WeatherStation.AirTemperature}}°</span>
        {{- end -}}
        {{- if .WeatherStation.SurfaceStatus -}}
        <span class="fact{{if isStale .WeatherStation.LastUpdated}} stale{{end}}">{{.WeatherStation.SurfaceStatus}}</span>
        {{- end -}}
        {{- if .WeatherStation.WindSpeedAvg -}}
        <span class="fact{{if isStale .WeatherStation.LastUpdated}} stale{{end}}">{{roundTemp .WeatherStation.WindSpeedAvg}} mph{{- if .WeatherStation.WindDirection}} {{.WeatherStation.WindDirection}}{{- end}}</span>
        {{- end -}}
        {{- if .WeatherStation.LastUpdated -}}
        <span class="fact muted{{if isStale .WeatherStation.LastUpdated}} stale{{end}}">{{formatTimeAgo .WeatherStation.LastUpdated}}</span>
        {{- end -}}
      </div>
      {{- end -}}
    </header>

    <main role="main" class="photo-stage">
      {{- if eq .Camera.Kind "iframe" -}}
      <iframe
        src="{{.Camera.Src}}"
        title="{{.Camera.Alt}}"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
        aria-label="{{.Camera.Alt}}"
        allowfullscreen>
      </iframe>
      {{- else -}}
      <img
        src="{{.ImageURL}}"
        alt="{{.Camera.Alt}}"
        loading="eager">
      {{- end -}}
    </main>

    {{- if .WeatherStation -}}
    <section class="weather-dense" aria-label="Weather conditions">
      <span class="wx-title">Weather</span>
      {{- if .WeatherStation.AirTemperature -}}
      <div class="wx"><span class="l">Air</span><span class="v">{{roundTemp .WeatherStation.AirTemperature}}°F</span></div>
      {{- end -}}
      {{- if .WeatherStation.SurfaceTemp -}}
      <div class="wx"><span class="l">Surface</span><span class="v">{{roundTemp .WeatherStation.SurfaceTemp}}°F</span></div>
      {{- end -}}
      {{- if .WeatherStation.SurfaceStatus -}}
      <div class="wx"><span class="l">Status</span><span class="v">{{.WeatherStation.SurfaceStatus}}</span></div>
      {{- end -}}
      {{- if .WeatherStation.WindSpeedAvg -}}
      <div class="wx"><span class="l">Wind</span><span class="v">{{.WeatherStation.WindSpeedAvg}}{{- if .WeatherStation.WindDirection}} {{.WeatherStation.WindDirection}}{{- end}}</span></div>
      {{- end -}}
      {{- if .WeatherStation.WindSpeedGust -}}
      <div class="wx"><span class="l">Gust</span><span class="v">{{.WeatherStation.WindSpeedGust}}</span></div>
      {{- end -}}
      {{- if .WeatherStation.Precipitation -}}
      <div class="wx"><span class="l">Precip</span><span class="v">{{precipIcon .WeatherStation.AirTemperature}}</span></div>
      {{- end -}}
      {{- if .WeatherStation.RelativeHumidity -}}
      <div class="wx"><span class="l">Humid</span><span class="v">{{.WeatherStation.RelativeHumidity}}%</span></div>
      {{- end -}}
      {{- if .WeatherStation.DewpointTemp -}}
      <div class="wx"><span class="l">Dew</span><span class="v">{{roundTemp .WeatherStation.DewpointTemp}}°F</span></div>
      {{- end -}}
      {{- if .WeatherStation.LastUpdated -}}
      <span class="wx-updated{{if isStale .WeatherStation.LastUpdated}} stale{{end}}">{{formatTimeAgo .WeatherStation.LastUpdated}} ago</span>
      {{- end -}}
    </section>
    {{- end -}}

    {{template "analytics" .}}
  </body>
</html>
